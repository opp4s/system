# ──────────────────────────────────────────────
# WhatsApp Lite — Backend Configuration
# Set these as environment variables on your server
# ──────────────────────────────────────────────

# Evolution API
EVOLUTION_URL=https://evolution.yourdomain.com
EVOLUTION_KEY=your_evolution_api_key

# Chatwoot (for auto-creating inboxes)
CHATWOOT_URL=https://chat.yourdomain.com
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_TOKEN=your_chatwoot_user_token

# n8n webhook base URL (where the frontend will call)
# This is the public URL of your n8n instance + /webhook
WA_LITE_API_BASE=https://api.yourdomain.com/webhook
