# Zavy CRM — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o .env com valores reais

# Banco de dados PostgreSQL
ZAVY_DB_PASSWORD=

# Rails
ZAVY_SECRET_KEY_BASE=        # rails secret (64+ bytes hex)

# JWT (Devise JWT)
ZAVY_JWT_SECRET=             # openssl rand -hex 32

# Integrações (opcionais no dev)
CHATWOOT_PLATFORM_TOKEN=
ASAAS_API_KEY=

# Mailer (Mailgun SMTP)
MAILGUN_SMTP_USER=
MAILGUN_SMTP_PASSWORD=
MAILER_FROM=noreply@zavycrm.com

# App
APP_HOST=https://app.zavycrm.com
