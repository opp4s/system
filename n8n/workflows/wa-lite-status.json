        "jsCode": "\nconst raw = $input.first().json;\nconst arr = Array.isArray(raw) ? raw : [raw];\nconst inst = arr[0] || {};\nreturn [{ json: {\n  status: inst.connectionStatus || 'close',\n  phone:  (inst.ownerJid || '').replace('@s.whatsapp.net','') || null,\n  qrCode: inst.qrcode?.base64 ? 'data:image/png;base64,' + inst.qrcode.base64 : null\n}}];\n"
