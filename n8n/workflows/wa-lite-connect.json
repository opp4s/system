  "name": "WA Lite — Connect",
  "description": null,
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "id": "wh",
      "name": "Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "wa-connect",
      "parameters": {
        "httpMethod": "POST",
        "path": "wa/connect",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "sa",
      "name": "Sanitize",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "fields": {
          "values": [
            {
              "name": "phone",
              "type": "string",
              "stringValue": "={{ $json.body.phone.replace(/\\D/g,'') }}"
            },
            {
              "name": "instanceName",
              "type": "string",
              "stringValue": "={{ $json.body.phone.replace(/\\D/g,'') + '_' + Date.now().toString(36) }}"
            },
            {
              "name": "usePairing",
              "type": "boolean",
              "booleanValue": "={{ $json.body.usePairing === true }}"
            },
            {
              "name": "chatwootAccountId",
              "type": "string",
              "stringValue": "={{ String($json.body.chatwootAccountId || '1') }}"
            },
            {
              "name": "chatwootToken",
              "type": "string",
              "stringValue": "={{ $json.body.chatwootToken }}"
            }
          ]
        }
      }
    },
    {
      "id": "ci",
      "name": "Create Instance",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://evolution-api:8080/instance/create",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "b1e46777454d01dfe014cd68e3bbf59d0a85515c3317b70c5e73a4c80005ae35"
            }
          ]
        },
        "options": {},
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={{ JSON.stringify({ instanceName: $json.instanceName, integration: \"WHATSAPP-BAILEYS\" }) }}"
      }
    },
    {
      "id": "gq",
      "name": "Get QR or Pairing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={  'http://evolution-api:8080/instance/connect/' + $('Sanitize').item.json.instanceName + ($('Sanitize').item.json.usePairing ? '?number=' + $('Sanitize').item.json.phone : '') }",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "b1e46777454d01dfe014cd68e3bbf59d0a85515c3317b70c5e73a4c80005ae35"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "cc",
      "name": "Config Chatwoot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={  'http://evolution-api:8080/chatwoot/set/' + $('Sanitize').item.json.instanceName }",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "b1e46777454d01dfe014cd68e3bbf59d0a85515c3317b70c5e73a4c80005ae35"
            }
          ]
        },
        "options": {},
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={{ JSON.stringify({ enabled: true, accountId: $(\"Sanitize\").item.json.chatwootAccountId, token: $(\"Sanitize\").item.json.chatwootToken, url: \"https://chat.opp4s.com\", signMsg: false, reopenConversation: true, conversationPending: false, nameInbox: $(\"Sanitize\").item.json.phone, autoCreate: true, importContacts: true, importMessages: false, daysLimitImportMessages: 0, mergeBrazilContacts: true }) }}"
      }
    },
    {
      "id": "rr",
      "name": "Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "fields": {
          "values": [
            {
              "name": "sessionId",
              "type": "string",
              "stringValue": "={{ $('Sanitize').item.json.instanceName }}"
            },
            {
              "name": "qrCode",
              "type": "string",
              "stringValue": "={{ $('Get QR or Pairing').item.json.base64 ? 'data:image/png;base64,' + $('Get QR or Pairing').item.json.base64 : null }}"
            },
            {
              "name": "pairingCode",
              "type": "string",
              "stringValue": "={{ $('Get QR or Pairing').item.json.code || null }}"
            }
          ]
        }
      }
    }
  ],
